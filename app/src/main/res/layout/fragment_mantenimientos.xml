<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="@string/mantenimientos_titulo"
            android:textColor="@color/text_on_background"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/surface"
            app:cardElevation="0dp"
            app:shapeAppearance="@style/ShapeTopRounded"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="24dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_search"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp">

                    <EditText
                        android:id="@+id/etBuscar"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/mantenimientos_buscar"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/text_on_field"
                        android:textColorHint="@color/text_hint"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_on_field" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTodos"
                            style="@style/EsChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/mantenimientos_filtro_todos" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCompletado"
                            style="@style/EsChipOperativo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mantenimientos_filtro_completado" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipProceso"
                            style="@style/EsChipMantenimiento"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mantenimientos_filtro_proceso" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipVencido"
                            style="@style/EsChipInactivo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mantenimientos_filtro_vencido" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/filaFiltros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFiltrosActivos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mantenimientos_filtros_activos"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTecnico"
                            style="@style/EsChipActivo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:closeIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipEquipo"
                            style="@style/EsChipActivo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:closeIconVisible="true" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnFiltroTecnico"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/mantenimientos_filtrar_tecnico"
                        android:src="@drawable/ic_tune"
                        app:tint="@color/text_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvVacio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="40dp"
                    android:text="@string/mantenimientos_vacio"
                    android:textColor="@color/text_primary"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMantenimientos"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="88dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/mantenimientos_agregar"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/primary"
        app:shapeAppearanceOverlay="@style/ShapeCircle"
        app:tint="@color/on_primary" />
</FrameLayout>