<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShapeTopRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">48dp</item>
        <item name="cornerSizeTopRight">48dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="EsLabel" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="EsInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/field_background</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="EsInput" parent="Widget.Material3.TextInputEditText.FilledBox">
        <item name="android:textColor">@color/text_on_field</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="EsButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="EsButtonSecondary" parent="EsButton">
        <item name="backgroundTint">@color/field_background</item>
        <item name="android:textColor">@color/text_on_field</item>
    </style>

    <style name="EsNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary</item>
        <item name="android:width">52dp</item>
        <item name="android:height">40dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Medium</item>
    </style>

    <style name="ShapeCircle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="EsChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">12sp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="EsDropdown" parent="Widget.Material3.AutoCompleteTextView.FilledBox">
        <item name="android:textColor">@color/text_on_field</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="EsChipOperativo" parent="EsChip">
        <item name="chipBackgroundColor">@color/estado_operativo_bg</item>
        <item name="android:textColor">@color/estado_operativo_text</item>
        <item name="chipStrokeWidth">2dp</item>
        <item name="chipStrokeColor">@color/chip_stroke_operativo</item>
    </style>

    <style name="EsChipMantenimiento" parent="EsChip">
        <item name="chipBackgroundColor">@color/estado_mantenimiento_bg</item>
        <item name="android:textColor">@color/estado_mantenimiento_text</item>
        <item name="chipStrokeWidth">2dp</item>
        <item name="chipStrokeColor">@color/chip_stroke_mantenimiento</item>
    </style>

    <style name="EsChipInactivo" parent="EsChip">
        <item name="chipBackgroundColor">@color/estado_inactivo_bg</item>
        <item name="android:textColor">@color/estado_inactivo_text</item>
        <item name="chipStrokeWidth">2dp</item>
        <item name="chipStrokeColor">@color/chip_stroke_inactivo</item>
    </style>

    <style name="EsChipActivo" parent="Widget.Material3.Chip.Input">
        <item name="chipBackgroundColor">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="closeIconTint">@color/on_primary</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">12sp</item>
    </style>

</resources>